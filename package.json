{
  "name": "pampanaa",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop lane defense shooter built with React, Vite, and Electron.",
  "author": "Pampanaa",
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "node --test tests",
    "electron": "electron .",
    "electron-dev": "bun run build && set \"ELECTRON_START_URL=dist/index.html\" && electron .",
    "electron-build": "bun run build && set \"CSC_IDENTITY_AUTO_DISCOVERY=false\" && electron-builder",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.32",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "main": "public/electron.cjs",
  "homepage": "./",
  "build": {
    "appId": "com.pampanaa.game",
    "productName": "Pampanaa",
    "files": [
      "dist/**/*",
      "public/electron.cjs",
      "public/preload.cjs"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icon.ico",
      "sign": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Game"
    }
  }
}
